# Konfigurasi publik Supabase (terbaca di bundle).
# Pakai anon/publishable key. JANGAN pernah isi service_role key di sini.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Tautan hukum/dukungan (isi setelah halaman web dipublikasikan dan data pengelola diisi; kosong = disembunyikan)
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_DELETE_ACCOUNT_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
